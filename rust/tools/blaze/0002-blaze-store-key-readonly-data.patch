@@ -0,0 +1,110 @@
+// What objc2 builds a method table from: a trait whose associated const is a slice, implemented
+// for tuples of every arity, and a trait of `extern "C"` function pointer types that names the
+// tuple of its arguments. `add_method` reads the length of the slice through the pointer type.
+use std::marker::PhantomData;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Encoding {
+    Char,
+    Int,
+    ULongLong,
+    LongLong,
+    Double,
+    Object,
+    Pointer(&'static Encoding),
+    Struct(&'static str, &'static [Encoding]),
+}
+
+pub unsafe trait Encode {
+    const ENCODING: Encoding;
+}
+unsafe impl Encode for usize {
+    const ENCODING: Encoding = Encoding::ULongLong;
+}
+unsafe impl Encode for isize {
+    const ENCODING: Encoding = Encoding::LongLong;
+}
+unsafe impl Encode for f64 {
+    const ENCODING: Encoding = Encoding::Double;
+}
+unsafe impl<T> Encode for *const T {
+    const ENCODING: Encoding = Encoding::Object;
+}
+unsafe impl<T: ?Sized> Encode for &T {
+    const ENCODING: Encoding = Encoding::Object;
+}
+
+pub unsafe trait EncodeArgument {
+    const ENCODING_ARGUMENT: Encoding;
+}
+unsafe impl<T: Encode> EncodeArgument for T {
+    const ENCODING_ARGUMENT: Encoding = T::ENCODING;
+}
+
+pub trait ConvertArgument {
+    type Inner: EncodeArgument;
+}
+impl<T: EncodeArgument> ConvertArgument for T {
+    type Inner = T;
+}
+
+pub trait EncodeArguments {
+    const ENCODINGS: &'static [Encoding];
+}
+macro_rules! encode_args {
+    ($($t:ident),*) => {
+        impl<$($t: EncodeArgument),*> EncodeArguments for ($($t,)*) {
+            const ENCODINGS: &'static [Encoding] = &[$($t::ENCODING_ARGUMENT),*];
+        }
+    };
+}
+encode_args!();
+encode_args!(A);
+encode_args!(A, B);
+encode_args!(A, B, C);
+
+#[derive(Clone, Copy)]
+pub struct Sel(*const u8);
+pub struct Object;
+pub trait Receiver {
+    type Inner: ?Sized;
+}
+impl Receiver for &Object {
+    type Inner = Object;
+}
+pub struct Allocated<T>(PhantomData<T>);
+
+pub trait Method: Sized {
+    type Callee: ?Sized;
+    type Arguments: EncodeArguments;
+}
+macro_rules! method {
+    ($($t:ident),*) => {
+        impl<T: ?Sized + Receiver, R, $($t: EncodeArgument),*> Method for extern "C" fn(T, Sel $(, $t)*) -> R {
+            type Callee = T::Inner;
+            type Arguments = ($($t,)*);
+        }
+        impl<T: ?Sized + Receiver, R, $($t: EncodeArgument),*> Method for unsafe extern "C" fn(T, Sel $(, $t)*) -> R {
+            type Callee = T::Inner;
+            type Arguments = ($($t,)*);
+        }
+    };
+}
+method!();
+method!(A);
+method!(A, B);
+method!(A, B, C);
+
+pub struct Builder {
+    pub log: Vec<String>,
+}
+impl Builder {
+    pub fn add_method<F: Method<Callee = Object>>(&mut self, sel: &str, _f: F) {
+        self.add_inner(sel, F::Arguments::ENCODINGS);
+    }
+    fn add_inner(&mut self, sel: &str, enc: &[Encoding]) {
+        let want = sel.matches(':').count();
+        let verdict = if want == enc.len() { "ok" } else { "MISMATCH" };
+        self.log.push(format!("{sel}: selector {want} function {} {verdict}", enc.len()));
+    }
+}
