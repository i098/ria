--- /dev/null
+++ b/harness/wholeprogram/c_abi_projection/src/main.rs
@@ -0,0 +1,47 @@
+// A value in the C ABI whose type is written as a projection, as objc2's `define_class!`
+// writes the arguments of a method (`<CGRect as ConvertArgument>::__Inner`): the ABI is the
+// one of the type it names.
+trait Convert<P> {
+    type Inner;
+}
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct Point {
+    x: f64,
+    y: f64,
+}
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct Rect {
+    origin: Point,
+    size: Point,
+}
+
+impl Convert<()> for Rect {
+    type Inner = Rect;
+}
+
+impl Convert<()> for Point {
+    type Inner = Point;
+}
+
+extern "C" fn area(r: <Rect as Convert<()>>::Inner) -> f64 {
+    r.size.x * r.size.y + r.origin.x
+}
+
+extern "C" fn swap(p: <Point as Convert<()>>::Inner) -> <Point as Convert<()>>::Inner {
+    Point { x: p.y, y: p.x }
+}
+
+fn through<T: Convert<()>, R>(f: extern "C" fn(T::Inner) -> R, value: T::Inner) -> R {
+    f(value)
+}
+
+fn main() {
+    let rect = Rect { origin: Point { x: 1.0, y: 2.0 }, size: Point { x: 3.0, y: 4.0 } };
+    let area = through::<Rect, f64>(std::hint::black_box(area), rect);
+    let swapped = through::<Point, Point>(std::hint::black_box(swap), rect.origin);
+    println!("{area} {} {}", swapped.x, swapped.y);
+}
