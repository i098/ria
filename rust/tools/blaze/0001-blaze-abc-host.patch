--- /dev/null
+++ b/harness/wholeprogram/std_threads/src/main.rs
@@ -0,0 +1,23 @@
+// `thread::spawn` reaches std's `MIN` (the stack size floor, a static in a function of
+// `std::sys::thread`), and `LocalKey::with` reaches the `__RUST_STD_INTERNAL_VAL` of a
+// `thread_local!`: statics with state that blaze links to the standard library's own copy.
+use std::cell::{Cell, RefCell};
+
+thread_local! {
+    static COUNT: Cell<u32> = const { Cell::new(1) };
+    static NAMES: RefCell<Vec<String>> = RefCell::new(vec!["main".to_owned()]);
+}
+
+fn main() {
+    let worker = std::thread::Builder::new()
+        .name("worker".to_owned())
+        .spawn(|| {
+            COUNT.with(|it| it.set(it.get() + 40));
+            NAMES.with(|it| it.borrow_mut().push("worker".to_owned()));
+            (COUNT.with(Cell::get), NAMES.with(|it| it.borrow().len()))
+        })
+        .unwrap();
+    let (count, names) = worker.join().unwrap();
+    COUNT.with(|it| it.set(it.get() + 1));
+    println!("{count} {names} {} {}", COUNT.with(Cell::get), NAMES.with(|it| it.borrow().len()));
+}
